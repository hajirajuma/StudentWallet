rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if request is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to verify user operates only on their own path
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Validation for user profile document
    function isValidUser() {
      let data = request.resource.data;
      return data.keys().hasAll(['uid', 'name', 'email'])
        && data.uid is string
        && data.name is string
        && data.email is string;
    }

    // Validation for transaction document
    function isValidTransaction() {
      let data = request.resource.data;
      return data.keys().hasAll(['id', 'amount', 'type', 'category', 'date'])
        && data.id is string
        && data.amount is number && data.amount >= 0
        && (data.type == 'INCOME' || data.type == 'EXPENSE')
        && data.category is string;
    }

    // Validation for monthly budget document
    function isValidBudget() {
      let data = request.resource.data;
      return data.keys().hasAll(['amount', 'month', 'year'])
        && data.amount is number && data.amount >= 0
        && data.month is int && data.month >= 1 && data.month <= 12
        && data.year is int;
    }

    // User Profile Document
    match /users/{userId} {
      allow read, update, delete: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser();

      // Transactions Subcollection
      match /transactions/{transactionId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidTransaction();
      }

      // Budgets Subcollection
      match /budgets/{budgetId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidBudget();
      }
    }

    // Deny access to any other document path by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
